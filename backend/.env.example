APP_NAME=SabiTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabitech_db
DB_USERNAME=sabitech_user
DB_PASSWORD=cambiar_esta_contrasena

# La base de datos contiene EXACTAMENTE las tablas del modelo de datos
# (database/Sentencia Creación.txt). Por eso sesiones, caché y colas no se
# guardan en la base de datos: no existen sus tablas.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_usuario_mailtrap
MAIL_PASSWORD=tu_contrasena_mailtrap
MAIL_FROM_ADDRESS="no-reply@sabitech.local"
MAIL_FROM_NAME="${APP_NAME}"
# Regenerar la documentaci�n de Swagger en cada petici�n (solo desarrollo).
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

APP_NAME=SabiTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabitech_db
DB_USERNAME=sabitech_user
DB_PASSWORD=cambiar_esta_contrasena

# El modelo de datos tiene 7 tablas. La tabla personal_access_tokens es
# tecnica (Sanctum) y se crea con database/Sanctum_PersonalAccessTokens.sql.
# Por eso sesiones, cache y colas no se guardan en la base de datos.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# En local el correo se escribe en storage/logs/laravel.log.
# Para verlo en Mailtrap, cambia MAIL_MAILER a smtp y rellena estos datos.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sabitech.local"
MAIL_FROM_NAME="${APP_NAME}"

# Regenerar la documentacion de Swagger en cada peticion (solo desarrollo).
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000
